---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1> Hello, Warriors</h1>
			<p>
			Welcome to VyomaSecurity awareness program by vyoma.co. This is our step toward making cyberspace a safer place. Here you will find various articles , blogs about our initiatives , security tips and tricks and much more to aware you about the cyber world.
			</p>
		</main>
		<Footer />
	</body>
</html>
